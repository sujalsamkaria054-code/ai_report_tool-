# =========================
# App
# =========================
APP_ENV=development
APP_NAME=multi-agent-report-tool

# =========================
# Backend API
# =========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# =========================
# Groq
# =========================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048

# =========================
# Hugging Face embeddings
# =========================
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=huggingface
# all-MiniLM-L6-v2 vector dimension is 384
EMBEDDING_DIMENSION=384

# =========================
# Supabase
# =========================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=public
SUPABASE_DOCUMENTS_TABLE=documents
SUPABASE_CHUNKS_TABLE=document_chunks
SUPABASE_MATCH_FUNCTION=match_document_chunks

# =========================
# Retrieval / chunking defaults
# =========================
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=5

# =========================
# Frontend public config
# =========================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
